{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "Exercise"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "title", "track"],
      "properties": {
        "name": {"type": "string"},
        "title": {"type": "string"},
        "track": {"type": "string"},
        "week": {"type": "integer"},
        "order": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["difficulty", "description", "environment", "checks", "hints"],
      "properties": {
        "difficulty": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"]
        },
        "estimatedTime": {"type": "string"},
        "points": {"type": "integer"},
        "description": {"type": "string"},
        "learningOutcomes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "prerequisites": {
          "type": "array",
          "items": {"type": "string"}
        },
        "environment": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["docker", "kubernetes", "hybrid"]
            },
            "kubernetes": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["kind", "vagrant"]
                },
                "kindConfig": {"type": "string"},
                "kind": {
                  "type": "object",
                  "properties": {
                    "clusterName": {"type": "string"},
                    "config": {"type": "string"}
                  },
                  "additionalProperties": true
                },
                "vagrant": {
                  "type": "object",
                  "properties": {
                    "bootstrapMode": {
                      "type": "string",
                      "enum": ["managed", "barenode"]
                    },
                    "box": {"type": "string"},
                    "kubernetesVersion": {"type": "string"},
                    "podCIDR": {"type": "string"},
                    "serviceCIDR": {"type": "string"},
                    "cni": {"type": "string"},
                    "sshUser": {"type": "string"},
                    "bootstrap": {"type": "boolean"},
                    "preinstall": {
                      "type": "object",
                      "properties": {
                        "installContainerd": {"type": "boolean"},
                        "installKubernetesPackages": {"type": "boolean"},
                        "configureKernelNetworking": {"type": "boolean"}
                      },
                      "additionalProperties": true
                    },
                    "topology": {
                      "type": "object",
                      "properties": {
                        "controlPlanes": {"type": "integer", "minimum": 0},
                        "workers": {"type": "integer", "minimum": 0}
                      },
                      "additionalProperties": true
                    },
                    "network": {
                      "type": "object",
                      "properties": {
                        "privateCidr": {"type": "string"}
                      },
                      "additionalProperties": true
                    },
                    "resources": {
                      "type": "object",
                      "properties": {
                        "controlPlane": {
                          "type": "object",
                          "properties": {
                            "cpus": {"type": "integer", "minimum": 0},
                            "memoryMb": {"type": "integer", "minimum": 0}
                          },
                          "additionalProperties": true
                        },
                        "worker": {
                          "type": "object",
                          "properties": {
                            "cpus": {"type": "integer", "minimum": 0},
                            "memoryMb": {"type": "integer", "minimum": 0}
                          },
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            },
            "docker": {"type": "object"},
            "customSetup": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {"type": "string"},
                  "script": {"type": "string"},
                  "condition": {"type": "string"},
                  "timeout": {"type": "string"},
                  "nodeExec": {
                    "type": "object",
                    "required": ["node"],
                    "properties": {
                      "node": {"type": "string"},
                      "user": {"type": "string"},
                      "script": {"type": "string"},
                      "timeout": {"type": "string"}
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type"]
          }
        },
        "hints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["cost"],
            "properties": {
              "cost": {"type": "integer"},
              "file": {"type": "string"},
              "content": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "successMessage": {"type": "string"},
        "nextExercise": {"type": "string"},
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "properties": {
              "title": {"type": "string"},
              "url": {"type": "string", "format": "uri"}
            }
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"]
          }
        },
        "variantSelection": {"type": "string"},
        "jerryDialog": {
          "type": "object",
          "properties": {
            "onStart":     {"type": "string"},
            "onCheckFail": {"type": "string"},
            "onCheckPass": {"type": "string"},
            "onHintUsed":  {"type": "string"},
            "onComplete":  {"type": "string"}
          },
          "additionalProperties": false
        },
        "tasking": {
          "type": "object",
          "required": ["ticket", "priority", "summary", "description"],
          "properties": {
            "ticket":      {"type": "string"},
            "priority":    {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
            "summary":     {"type": "string"},
            "description": {"type": "string"},
            "reporter":    {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
